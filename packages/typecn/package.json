{
  "name": "typecn",
  "version": "0.1.0",
  "description": "50 open-source kinetic typography animations for React.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./effects/*": {
      "types": "./dist/effects/*.d.ts",
      "import": "./dist/effects/*.js",
      "require": "./dist/effects/*.cjs"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "react",
    "typography",
    "animation",
    "kinetic-type",
    "text-effects",
    "motion"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/arjunkshah12345-hash/typecn.git",
    "directory": "packages/typecn"
  }
}
